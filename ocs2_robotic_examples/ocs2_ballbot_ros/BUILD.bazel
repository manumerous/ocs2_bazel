load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_multirun//:defs.bzl", "command", "multirun")
load("//bazel:ocs2_cxx_flags.bzl", "OCS2_LINKOPTS", "OCS2_ROS2_COPTS")

package(default_visibility = ["//visibility:public"])

# PARTIAL MIGRATION -- see the phase 5 progress reports for full detail.
#
# Still skipped, as genuine pre-existing dead code (not migration
# casualties -- matches the repo-wide finding that no CI ever builds this
# ROS2 tree):
#   - `ballbot_sqp` (BallbotSqpMpcNode.cpp) still `#include`s
#     `<ros/init.h>`/`<ros/package.h>`/`<ocs2_ros_interfaces/...>` --
#     genuine ROS1-era code referencing the out-of-scope legacy
#     `ocs2_ros_interfaces` package, not a mechanical build-system port.
#   - `ballbot_integration_test` (test/ballbotIntegrationTest.cpp) is the
#     same kind of ROS1-era dead code; its own CMakeLists.txt registration
#     is also missing the `find_package(ament_cmake_gtest)` its own
#     `ament_add_gtest()` call needs, so it was never a real active
#     target either.
#
# Now migrated too, after the orocos_kdl/kdl_parser scope expansion
# unblocked them: the "ocs2_ballbot_ros" library itself
# (BallbotDummyVisualization.cpp, which needs
# `#include <kdl_parser/kdl_parser.hpp>`), `ballbot_dummy_test`, and
# `ballbot_mpc_mrt`.
_DEPS = [
    "//ocs2_core",
    "//ocs2_ddp",
    "//ocs2_mpc",
    "//ocs2_robotic_examples/ocs2_ballbot",
    "//ocs2_robotic_tools",
    "//ocs2_ros2_interfaces",
    "//ocs2_ros2_msgs:cc",
    "@ament_index_cpp//:ament_index_cpp_library",
    "@kdl_parser",
    "@rclcpp//:rclcpp_library",
    "@sensor_msgs//:cc",
    "@visualization_msgs//:cc",
]

cc_library(
    name = "ocs2_ballbot_ros",
    srcs = ["src/BallbotDummyVisualization.cpp"],
    hdrs = glob(["include/**/*.h"]),
    copts = OCS2_ROS2_COPTS,
    includes = ["include"],
    linkopts = OCS2_LINKOPTS,
    deps = _DEPS,
)

# data: makes ament_index_cpp::get_package_share_directory("ocs2_ballbot")
# (config/task.info, auto_generated/) resolve at runtime -- see the
# ament_index target in ocs2_ballbot/BUILD.bazel.
cc_binary(
    name = "ballbot_ddp",
    srcs = ["src/BallbotDdpMpcNode.cpp"],
    copts = OCS2_ROS2_COPTS,
    data = ["//ocs2_robotic_examples/ocs2_ballbot:ament_index"],
    linkopts = OCS2_LINKOPTS,
    deps = [
        "//ocs2_ddp",
        "//ocs2_robotic_examples/ocs2_ballbot",
        "//ocs2_ros2_interfaces",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@rclcpp//:rclcpp_library",
    ],
)

cc_binary(
    name = "ballbot_slp",
    srcs = ["src/BallbotSlpMpcNode.cpp"],
    copts = OCS2_ROS2_COPTS,
    data = ["//ocs2_robotic_examples/ocs2_ballbot:ament_index"],
    linkopts = OCS2_LINKOPTS,
    deps = [
        "//ocs2_robotic_examples/ocs2_ballbot",
        "//ocs2_ros2_interfaces",
        "//ocs2_slp",
        "@ament_index_cpp//:ament_index_cpp_library",
        "@rclcpp//:rclcpp_library",
    ],
)

cc_binary(
    name = "ballbot_target",
    srcs = ["src/BallbotTargetPoseCommand.cpp"],
    copts = OCS2_ROS2_COPTS,
    linkopts = OCS2_LINKOPTS,
    deps = [
        "//ocs2_robotic_examples/ocs2_ballbot",
        "//ocs2_ros2_interfaces",
        "@rclcpp//:rclcpp_library",
    ],
)

# Matches the original CMakeLists.txt exactly: ballbot_dummy_test and
# ballbot_mpc_mrt each compile BallbotDummyVisualization.cpp directly
# into the binary (`add_executable(ballbot_dummy_test
# src/DummyBallbotNode.cpp src/BallbotDummyVisualization.cpp)`) rather
# than linking against the "ocs2_ballbot_ros" library -- so those two
# binaries do the same here, plus glob(["include/**/*.h"]) since
# they're compiling BallbotDummyVisualization.h's implementation
# directly rather than picking it up via the library target's hdrs.
cc_binary(
    name = "ballbot_dummy_test",
    srcs = [
        "src/BallbotDummyVisualization.cpp",
        "src/DummyBallbotNode.cpp",
    ] + glob(["include/**/*.h"]),
    copts = OCS2_ROS2_COPTS,
    data = ["//ocs2_robotic_examples/ocs2_ballbot:ament_index"],
    includes = ["include"],
    linkopts = OCS2_LINKOPTS,
    deps = _DEPS,
)

cc_binary(
    name = "ballbot_mpc_mrt",
    srcs = [
        "src/BallbotDummyVisualization.cpp",
        "src/BallbotMpcMrtNode.cpp",
    ] + glob(["include/**/*.h"]),
    copts = OCS2_ROS2_COPTS,
    data = ["//ocs2_robotic_examples/ocs2_ballbot:ament_index"],
    includes = ["include"],
    linkopts = OCS2_LINKOPTS,
    deps = _DEPS,
)

# ---------------------------------------------------------------------------
# Bringup: replaces ballbot_ddp.launch / ballbot_slp.launch (minus rviz --
# rviz2 isn't a Bazel target in this workspace; see the MODULE.bazel note on
# RCR scope). `ballbot_sqp` has no bringup since `ballbot_sqp` itself isn't
# buildable (dead ROS1 code, see the note above).
#
#   bazel run //ocs2_robotic_examples/ocs2_ballbot_ros:bringup_ballbot_ddp
#   bazel run //ocs2_robotic_examples/ocs2_ballbot_ros:bringup_ballbot_slp
#
# each starts its MPC solver together with the dummy simulator, one terminal,
# one Ctrl-C stops both. ballbot_target (the interactive pose commander) is
# NOT included: it blocks on interactive std::cin
# (TargetTrajectoriesKeyboardPublisher), and rules_multirun's parallel mode
# can't give it its own terminal or route keystrokes to just one command --
# that's exactly what its `gnome-terminal --` window did in the old launch
# file. Run it on demand, in its own terminal, via:
#
#   bazel run //ocs2_robotic_examples/ocs2_ballbot_ros:run_ballbot_target
#
# All targets default to task_name="mpc", matching the old launch files.
command(
    name = "_bringup_ballbot_ddp_mpc",
    arguments = ["mpc"],
    command = ":ballbot_ddp",
    description = "mpc solver (ballbot_ddp)",
)

command(
    name = "_bringup_ballbot_ddp_dummy",
    arguments = ["mpc"],
    command = ":ballbot_dummy_test",
    description = "dummy simulator (ballbot_dummy_test)",
)

multirun(
    name = "bringup_ballbot_ddp",
    commands = [
        ":_bringup_ballbot_ddp_mpc",
        ":_bringup_ballbot_ddp_dummy",
    ],
    jobs = 0,  # 0 == run in parallel, like separate launch-file terminals
)

command(
    name = "_bringup_ballbot_slp_mpc",
    arguments = ["mpc"],
    command = ":ballbot_slp",
    description = "mpc solver (ballbot_slp)",
)

command(
    name = "_bringup_ballbot_slp_dummy",
    arguments = ["mpc"],
    command = ":ballbot_dummy_test",
    description = "dummy simulator (ballbot_dummy_test)",
)

multirun(
    name = "bringup_ballbot_slp",
    commands = [
        ":_bringup_ballbot_slp_mpc",
        ":_bringup_ballbot_slp_dummy",
    ],
    jobs = 0,
)

# ballbot_mpc_mrt.launch: MPC and MRT loop run in a single combined process
# (ballbot_mpc_mrt), so there's nothing to multirun here -- just the one
# process with its task_name argument baked in.
command(
    name = "bringup_ballbot_mpc_mrt",
    arguments = ["mpc"],
    command = ":ballbot_mpc_mrt",
    description = "combined mpc+mrt loop (ballbot_mpc_mrt)",
)

command(
    name = "run_ballbot_target",
    arguments = ["mpc"],
    command = ":ballbot_target",
    description = "interactive pose commander (ballbot_target) -- run in its own terminal",
)
