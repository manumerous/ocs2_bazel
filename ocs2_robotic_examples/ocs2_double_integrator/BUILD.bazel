load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:ocs2_cxx_flags.bzl", "OCS2_COPTS", "OCS2_LINKOPTS")

package(default_visibility = ["//visibility:public"])

# NOTE: the Python bindings (pyBindModule.cpp/DoubleIntegratorPyBindings.h,
# setup.py) are commented out in the original CMakeLists.txt too -- not
# migrated here, matching the "no active target" rule.
cc_library(
    name = "ocs2_double_integrator",
    srcs = ["src/DoubleIntegratorInterface.cpp"],
    hdrs = glob(["include/**/*.h"]),
    copts = OCS2_COPTS,
    includes = ["include"],
    linkopts = OCS2_LINKOPTS + ["-ldl"],
    deps = [
        "//ocs2_core",
        "//ocs2_ddp",
        "//ocs2_mpc",
        "//ocs2_robotic_tools",
        "//ocs2_sqp/ocs2_sqp",
        "@boost.filesystem",
        "@boost.system",
        "@eigen",
    ],
)

filegroup(
    name = "config",
    srcs = glob(["config/**"]),
)

# Makes config/task.info and auto_generated/ show up at runtime under
# share/ocs2_double_integrator/ in the runfiles tree, so
# ament_index_cpp::get_package_share_directory("ocs2_double_integrator")
# (called from ocs2_double_integrator_ros's nodes) can find them without a
# real ROS install / AMENT_PREFIX_PATH -- see @rosdistro//ament:defs.bzl.
ament_index(
    name = "ament_index",
    data = glob([
        "config/**",
        "auto_generated/**",
    ]),
    data_strip_prefix = "ocs2_robotic_examples/ocs2_double_integrator",
    export_name = "ocs2_double_integrator",
)
