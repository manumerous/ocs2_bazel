load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_multirun//:defs.bzl", "command", "multirun")
load("//bazel:ocs2_cxx_flags.bzl", "OCS2_LINKOPTS", "OCS2_ROS2_COPTS")

package(default_visibility = ["//visibility:public"])

# NOTE (dead pre-existing code, not a migration casualty -- matches the
# repo-wide "no CI ever builds this ROS2 tree" finding):
#   - `legged_robot_ipm_mpc` (LeggedRobotIpmMpcNode.cpp) still
#     `#include`s `<ros/init.h>`/`<ros/package.h>`/
#     `<ocs2_ros_interfaces/...>` -- genuine ROS1-era code.
#
# `legged_robot_sqp_mpc` (LeggedRobotSqpMpcNode.cpp) was otherwise clean
# ROS2 already, apart from including
# `<ocs2_ros_interfaces/synchronized_module/SolverObserverRosCallbacks.h>`
# for an optional multiplot friction-cone/zero-velocity constraint
# observer -- that header exists only in the out-of-scope legacy
# `ocs2_ros_interfaces` package, with no ocs2_ros2_interfaces equivalent
# (confirmed: it was never ported). Rather than port that ROS2 feature,
# the node below drops the multiplot observer hookup entirely and mirrors
# LeggedRobotDdpMpcNode.cpp's plain MPC_ROS_Interface wiring with SqpMpc
# in place of GaussNewtonDDP_MPC.
_DEPS = [
    "//ocs2_core",
    "//ocs2_ddp",
    "//ocs2_pinocchio/ocs2_centroidal_model",
    "//ocs2_pinocchio/ocs2_pinocchio_interface",
    "//ocs2_robotic_examples/ocs2_legged_robot",
    "//ocs2_robotic_tools",
    "//ocs2_ros2_interfaces",
    "//ocs2_ros2_msgs:cc",
    "@ament_index_cpp//:ament_index_cpp_library",
    "@geometry_msgs//:cc",
    "@kdl_parser",
    "@pinocchio",
    "@rclcpp//:rclcpp_library",
    "@sensor_msgs//:cc",
    "@urdf//:urdf_library",
    "@visualization_msgs//:cc",
]

# Makes urdf/urdf/anymal.urdf (+ meshes) show up at runtime under
# share/ocs2_legged_robot_ros/ in the runfiles tree, so
# ament_index_cpp::get_package_share_directory("ocs2_legged_robot_ros")
# (called from LeggedRobotDdpMpcNode/LeggedRobotDummyNode) can find it
# without a real ROS install / AMENT_PREFIX_PATH -- see
# @rosdistro//ament:defs.bzl.
ament_index(
    name = "ament_index",
    data = glob(["urdf/**"]),
    data_strip_prefix = "ocs2_robotic_examples/ocs2_legged_robot_ros",
    export_name = "ocs2_legged_robot_ros",
)

cc_library(
    name = "ocs2_legged_robot_ros",
    srcs = [
        "src/gait/GaitKeyboardPublisher.cpp",
        "src/gait/GaitReceiver.cpp",
        "src/gait/GaitWebPublisher.cpp",
        "src/visualization/LeggedRobotVisualizer.cpp",
    ],
    hdrs = glob(["include/**/*.h"]),
    copts = OCS2_ROS2_COPTS,
    includes = ["include"],
    linkopts = OCS2_LINKOPTS,
    # @httplib not added to the shared _DEPS: only GaitWebPublisher.cpp here needs it.
    deps = _DEPS + ["@httplib"],
)

# data: makes ament_index_cpp::get_package_share_directory("ocs2_legged_robot")
# (config/*.info) and ("ocs2_legged_robot_ros") (urdf/urdf/anymal.urdf)
# resolve at runtime -- see the ament_index targets in
# ocs2_legged_robot/BUILD.bazel and above.
cc_binary(
    name = "legged_robot_ddp_mpc",
    srcs = ["src/LeggedRobotDdpMpcNode.cpp"],
    copts = OCS2_ROS2_COPTS,
    data = [
        ":ament_index",
        "//ocs2_robotic_examples/ocs2_legged_robot:ament_index",
    ],
    linkopts = OCS2_LINKOPTS,
    deps = [":ocs2_legged_robot_ros"] + _DEPS,
)

cc_binary(
    name = "legged_robot_sqp_mpc",
    srcs = ["src/LeggedRobotSqpMpcNode.cpp"],
    copts = OCS2_ROS2_COPTS,
    data = [
        ":ament_index",
        "//ocs2_robotic_examples/ocs2_legged_robot:ament_index",
    ],
    linkopts = OCS2_LINKOPTS,
    deps = [
        ":ocs2_legged_robot_ros",
        "//ocs2_sqp/ocs2_sqp",
    ] + _DEPS,
)

cc_binary(
    name = "legged_robot_dummy",
    srcs = ["src/LeggedRobotDummyNode.cpp"],
    copts = OCS2_ROS2_COPTS,
    data = [
        ":ament_index",
        "//ocs2_robotic_examples/ocs2_legged_robot:ament_index",
    ],
    linkopts = OCS2_LINKOPTS,
    deps = [":ocs2_legged_robot_ros"] + _DEPS,
)

# data: legged_robot_target only needs ocs2_legged_robot's config/reference.info.
cc_binary(
    name = "legged_robot_target",
    srcs = ["src/LeggedRobotPoseCommandNode.cpp"],
    copts = OCS2_ROS2_COPTS,
    data = ["//ocs2_robotic_examples/ocs2_legged_robot:ament_index"],
    linkopts = OCS2_LINKOPTS,
    deps = [":ocs2_legged_robot_ros"] + _DEPS,
)

# data: legged_robot_gait_command only needs ocs2_legged_robot's config/gait.info.
cc_binary(
    name = "legged_robot_gait_command",
    srcs = ["src/LeggedRobotGaitCommandNode.cpp"],
    copts = OCS2_ROS2_COPTS,
    data = ["//ocs2_robotic_examples/ocs2_legged_robot:ament_index"],
    linkopts = OCS2_LINKOPTS,
    deps = [":ocs2_legged_robot_ros"] + _DEPS,
)

# Browser-form versions of the two commanders above; wired into bringup_anymal[_sqp] below.
cc_binary(
    name = "legged_robot_target_web",
    srcs = ["src/LeggedRobotPoseCommandNodeWeb.cpp"],
    copts = OCS2_ROS2_COPTS,
    data = ["//ocs2_robotic_examples/ocs2_legged_robot:ament_index"],
    linkopts = OCS2_LINKOPTS,
    deps = [":ocs2_legged_robot_ros"] + _DEPS,
)

cc_binary(
    name = "legged_robot_gait_command_web",
    srcs = ["src/LeggedRobotGaitCommandNodeWeb.cpp"],
    copts = OCS2_ROS2_COPTS,
    data = ["//ocs2_robotic_examples/ocs2_legged_robot:ament_index"],
    linkopts = OCS2_LINKOPTS,
    deps = [":ocs2_legged_robot_ros"] + _DEPS,
)

# ---------------------------------------------------------------------------
# Bringup: replaces anymal.launch.py's node set (minus rviz -- rviz2 isn't a
# Bazel target in this workspace; see the MODULE.bazel note on RCR scope).
# legged_robot_ipm_mpc isn't wired here since it isn't buildable (see the
# dead-code note above).
#
#   bazel run //ocs2_robotic_examples/ocs2_legged_robot_ros:bringup_anymal
#   bazel run //ocs2_robotic_examples/ocs2_legged_robot_ros:bringup_anymal_sqp
#
# starts the MPC solver, the dummy simulator, and the browser-form pose/gait
# commanders (legged_robot_target_web on http://localhost:8081/,
# legged_robot_gait_command_web on http://localhost:8082/) together,
# streaming all four logs to one terminal; Ctrl-C stops all of them. The
# original std::cin commanders aren't part of this multirun -- they need
# their own terminal. Run those on demand, each in its own terminal, via:
#
#   bazel run //ocs2_robotic_examples/ocs2_legged_robot_ros:run_anymal_target
#   bazel run //ocs2_robotic_examples/ocs2_legged_robot_ros:run_anymal_gait_command
#
# All commands default to the same (task_name="mpc", reference_name=
# "command") pair anymal.launch.py used.
command(
    name = "_bringup_anymal_mpc",
    arguments = [
        "mpc",
        "command",
    ],
    command = ":legged_robot_ddp_mpc",
    description = "mpc solver (legged_robot_ddp_mpc)",
)

command(
    name = "_bringup_anymal_dummy",
    arguments = [
        "mpc",
        "command",
    ],
    command = ":legged_robot_dummy",
    description = "dummy simulator (legged_robot_dummy)",
)

command(
    name = "_bringup_anymal_target_web",
    arguments = [
        "mpc",
        "command",
    ],
    command = ":legged_robot_target_web",
    description = "pose commander form (legged_robot_target_web, http://localhost:8081/)",
)

command(
    name = "_bringup_anymal_gait_command_web",
    arguments = [
        "mpc",
        "command",
    ],
    command = ":legged_robot_gait_command_web",
    description = "gait commander form (legged_robot_gait_command_web, http://localhost:8082/)",
)

multirun(
    name = "bringup_anymal",
    commands = [
        ":_bringup_anymal_mpc",
        ":_bringup_anymal_dummy",
        ":_bringup_anymal_target_web",
        ":_bringup_anymal_gait_command_web",
    ],
    jobs = 0,  # 0 == run in parallel, like separate launch-file terminals
)

command(
    name = "_bringup_anymal_sqp_mpc",
    arguments = [
        "mpc",
        "command",
    ],
    command = ":legged_robot_sqp_mpc",
    description = "mpc solver (legged_robot_sqp_mpc)",
)

multirun(
    name = "bringup_anymal_sqp",
    commands = [
        ":_bringup_anymal_sqp_mpc",
        ":_bringup_anymal_dummy",
        ":_bringup_anymal_target_web",
        ":_bringup_anymal_gait_command_web",
    ],
    jobs = 0,  # 0 == run in parallel, like separate launch-file terminals
)

command(
    name = "run_anymal_target",
    arguments = [
        "mpc",
        "command",
    ],
    command = ":legged_robot_target",
    description = "interactive pose commander (legged_robot_target) -- run in its own terminal",
)

command(
    name = "run_anymal_gait_command",
    arguments = [
        "mpc",
        "command",
    ],
    command = ":legged_robot_gait_command",
    description = "interactive gait commander (legged_robot_gait_command) -- run in its own terminal",
)
