# RCR listed first so it takes precedence over BCR for shared module names (e.g. pinocchio).
common --registry=https://openrobotics.github.io/ros-central-registry
common --registry=https://bcr.bazel.build

# Test hermeticity, per RCR's own guidance for ROS2 interface/codegen tests.
test --sandbox_default_allow_network=false

# Default to optimized builds; use -c fastbuild for a quicker edit/rebuild cycle.
build --compilation_mode=opt

# Static linking; dynamic_mode=default breaks boost.log symbol resolution at .so boundaries.
build --dynamic_mode=off

# Avoid pulling in every RMW backend (rmw_zenoh_cpp needs a Rust toolchain); pin the default one.
build --@rosdistro//:rmw=rmw_fastrtps_cpp

# The existing CMake build pins C++14 (see ocs2_core/cmake/ocs2_cxx_flags.cmake),
# but OCS2's own Bazel targets are instead built at C++23 -- deliberately NOT
# as a global --cxxopt here, since that would also force every external
# dependency onto C++23. Instead, "-std=c++23" is added directly to
# OCS2_COPTS/OCS2_TEST_COPTS/OCS2_ROS2_COPTS (bazel/ocs2_cxx_flags.bzl) on
# OCS2's own cc_library/cc_binary/cc_test targets only. Everything else
# (external deps, including googletest) is left on the toolchain's own
# ambient default, which happens to already be gnu++17 on the GCC 13 this
# was verified against.
